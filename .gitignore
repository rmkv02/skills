# Зеркала скиллов в каталогах агентов. Генерируются scripts/install.sh из
# skills/<layer>/<name>/ — коммит зеркала это дубль контента и гарантированный
# дрейф (код E-COMMITTED-MIRROR).
.claude/skills/
.agents/skills/
.opencode/skills/
.cursor/skills/

# Сводка для агентов без поддержки скиллов. Генерируется из выбранного профиля,
# поэтому у разных потребителей разное содержимое.
dist/

# Манифесты плагинов (.claude-plugin/) НЕ игнорируются: CI сверяет их с
# регенерацией из registry.yaml, а для этого они должны быть в дереве.

__pycache__/
*.py[cod]
.DS_Store
